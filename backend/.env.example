# Server Port
PORT=5000
NODE_ENV=development

# AWS Configuration (default credential provider chain handles AWS keys)
AWS_REGION=us-east-1

# DynamoDB Table Names
LEADS_TABLE=Growvia-Leads
DEALS_TABLE=Growvia-Deals
USERS_TABLE=Growvia-Users

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Optional: Local DynamoDB endpoint (e.g. for dynamodb-local)
# DYNAMODB_ENDPOINT=http://localhost:8000
